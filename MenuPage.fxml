<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?> <!-- Import HBox correctly -->

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Menu">
    <children>
        <!-- Page Label to show the current page number -->
        <Label fx:id="pageLabel" text="Page 1" />

        <!-- ListView to display the products -->
        <ListView fx:id="productListView" />

        <!-- Buttons for pagination, wrapped in HBox for horizontal layout -->
        <HBox alignment="CENTER" spacing="20">
            <Button fx:id="prevPageButton" text="Previous Page" />
            <Button fx:id="nextPageButton" text="Next Page" />
        </HBox>

        <!-- Button for joining a group (additional functionality) -->
        <Button fx:id="joinGroupButton" text="Join Group" />
    </children>
</VBox>
